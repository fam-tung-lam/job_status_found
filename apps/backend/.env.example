# Copy to `.env`, which Git and the Docker build context both ignore.
# One set of `JSF_DATABASE_*` values serves everything: Docker Compose creates
# the PostgreSQL role and database from them and passes them to the backend
# container, and a backend started on the host with `uv run` reads them directly.

JSF_DATABASE_NAME=job_status_found
JSF_DATABASE_USER=job_status_found
JSF_DATABASE_PASSWORD=change-me

# Host port PostgreSQL is published on in development, and the port every host
# command connects to: `uv run uvicorn`, `uv run alembic`, and `uv run pytest`
# (optional; change it when another service holds 5432).
# JSF_DATABASE_PORT=5432

# Host port the backend is published on (optional).
# BACKEND_PORT=8000
