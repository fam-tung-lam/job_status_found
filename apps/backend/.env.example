# Copy to `.env`, which Git and the Docker build context both ignore.
# One set of `JSF_DATABASE_*` values serves everything: Docker Compose creates
# the PostgreSQL role and database from them and passes them to the backend
# container, and a backend started on the host with `uv run` reads them directly.

JSF_DATABASE_NAME=job_status_found
JSF_DATABASE_USER=job_status_found
JSF_DATABASE_PASSWORD=change-me

# Host port PostgreSQL is published on in development, and the port every host
# command connects to: `uv run uvicorn`, `uv run alembic`, and `uv run pytest`
# (optional; change it when another service holds 5432).
# JSF_DATABASE_PORT=5432

# Host port the backend is published on (optional).
# BACKEND_PORT=8000

# Auth. Every `JSF_AUTH_*` secret is a `SecretStr`: never logged, never in the image.
# Server key for HMAC-SHA-256 of emailed codes, at least 32 characters, so this
# placeholder stops the start-up until it is replaced. Generate one with
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JSF_AUTH_HMAC_KEY=change-me

# Core: the SMTP server every feature sends email through. These values reach
# the Mailpit that `docker compose up` starts in development; its web UI is on
# http://localhost:8025 (`MAILPIT_WEB_PORT`). The development backend container
# always uses `mailpit:1025` instead.
# Production uses the Resend SMTP relay: host `smtp.resend.com`, port 587,
# security `starttls`, user `resend`, and a Resend API key as the password.
# Security `none` refuses a user name or password, which it would send in the clear.
# `From` address of every email.
JSF_SMTP_SENDER=JSV <no-reply@localhost>
JSF_SMTP_HOST=localhost
JSF_SMTP_PORT=1025
JSF_SMTP_SECURITY=none
# JSF_SMTP_USERNAME=
# JSF_SMTP_PASSWORD=
# MAILPIT_WEB_PORT=8025

# Optional; the defaults follow the auth specification.
# JSF_AUTH_PASSWORD_MIN_LENGTH=12
# JSF_AUTH_VERIFICATION_CODE_LIFETIME=PT15M
# JSF_AUTH_VERIFICATION_CODE_SEND_INTERVAL=PT60S
# Keep above the slowest sign-up so every branch answers at the same moment.
# JSF_AUTH_SIGN_UP_MIN_RESPONSE_TIME=PT0.5S
